# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# Existing MySQL database (the PHP app used "mess_management").
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mess_management
DB_USER=root
DB_PASSWORD=

# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_secret

# Public address of the app (used in startup logs).
BASE_URL=http://localhost:3000
# URL prefix. Leave empty to serve at "/", or set to /mess_management to keep the PHP URLs.
BASE_PATH=

# QR signing key (64 hex chars). If empty, storage/qr.key is used (created by npm run migrate).
QR_SECRET=

# Behind a reverse proxy / load balancer that terminates HTTPS, set TRUST_PROXY=1.
TRUST_PROXY=
# Defaults to true in production. Set false only for plain-HTTP testing in production mode.
COOKIE_SECURE=
