{
  "name": "medico-junction",
  "version": "2.0.0",
  "private": true,
  "description": "Medico Junction meal attendance — Node.js/Express backend with the original frontend",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,ejs src/server.js",
