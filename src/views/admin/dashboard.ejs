<%- include('../partials/page-start', { title: 'Overview', active: 'dashboard', full: false }) %>
<%- include('../partials/notice') %>
<%- include('../partials/heading', { eyebrow: 'THE DAILY TABLE', heading: 'A good day starts with a good meal.', description: 'Your meal service, attendance, and people — all in one place.', actions: '<a class="button primary" href="meal-qr.php">' + icon('qr') + ' Open counter QR</a>' }) %>
<section class="service-banner"><div><span class="live-dot"></span><strong id="service-status"><%= d.service.message %></strong><small>Service follows Asia/Kolkata server time</small></div><a href="meal-settings.php">Manage timings →</a></section>
<%- include('../partials/filter-form', { admin: true, view: '' }) %>
<%- include('../partials/cards', { counts: d.totals, employees: f.from === f.to ? d.active_employees : null }) %>
<div class="dashboard-grid">
<section class="panel"><div class="panel-heading"><div><h2>Meal consumption</h2><p>Daily meals in your selected date range</p></div><span class="pill soft"><%= f.from %> — <%= f.to %></span></div><div class="chart-wrap"><canvas id="trend-chart" aria-label="Daily meal consumption chart" role="img"></canvas><p class="chart-loading">Loading chart…</p></div></section>
<section class="panel"><div class="panel-heading"><div><h2>At a glance</h2><p>Your people and their meals</p></div></div><div class="people-count"><strong><%= d.active_employees %></strong><span>active employees<br><small><%= d.employees %> total employees</small></span></div><div class="donut-wrap"><canvas id="distribution-chart" aria-label="Meal distribution chart" role="img"></canvas></div><a href="employees.php" class="panel-link">View all employees <%- icon('arrow') %></a></section>
</div>
<section class="panel"><div class="panel-heading"><div><h2>Last 7 days</h2><p>Breakfast, lunch, and dinner consumption</p></div></div><div class="chart-wrap short"><canvas id="week-chart" aria-label="Seven day meal consumption chart" role="img"></canvas></div></section>
<section class="panel"><div class="panel-heading"><div><h2>Recent meal attendance</h2><p>Newest dates first · updates automatically</p></div><a class="text-link" href="attendance.php">View attendance →</a></div><div id="recent-scans"><%- include('../partials/attendance-table', { records: d.recent, correct: false, offset: 0 }) %></div></section>
<script src="<%= base %>/assets/vendor/chart.umd.min.js"></script>
<script defer src="<%= base %>/assets/js/dashboard-medico.js"></script>
<%- include('../partials/page-end') %>
