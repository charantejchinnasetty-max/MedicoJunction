<%#
  Locals: form (null or { id, values }), list, q, status
-%>
<%- include('../partials/page-start', { title: 'Employees', active: 'employees', full: false }) %>
<%- include('../partials/notice') %>
<%- include('../partials/heading', { eyebrow: 'OUR PEOPLE', heading: 'A place for everyone.', description: 'Manage employee access, profiles, and meal history.', actions: '<a class="button" href="export_employees">Export CSV</a><a class="button primary" href="?edit=new">+ Add employee</a>' }) %>
<%_ if (form) { const r = form.values; _%>
<section class="panel form-panel"><h2><%= form.id ? 'Edit employee' : 'New employee' %></h2>
<form method="post" enctype="multipart/form-data"><%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= form.id %>">
<div class="form-grid">
<%_ for (const [k, label, type, max] of [['employee_name', 'Employee name', 'text', 100], ['employee_code', 'Employee ID', 'text', 20], ['mobile', 'Mobile number', 'tel', 15], ['department', 'Department', 'text', 50], ['designation', 'Designation', 'text', 100], ['joining_date', 'Joining date', 'date', 10]]) { _%>
<label><%= label %><input type="<%= type %>" name="<%= k %>" maxlength="<%= max %>" value="<%= r[k] ?? '' %>" <%= ['employee_name', 'employee_code'].includes(k) ? 'required' : '' %>></label>
<%_ } _%>
<label class="check-label"><input type="checkbox" name="reset_password"> Reset to common employee password</label>
<p>Employees sign in with their mobile number. New employees receive the common password automatically.</p>
<label>Profile photo<input type="file" name="photo" accept="image/png,image/jpeg"><small>JPG / PNG · max 2 MB</small></label>
<label class="check-label"><input type="checkbox" name="active" <%= Number(r.active ?? 1) || (typeof r.active === 'string' && r.active !== '' && r.active !== '0') ? 'checked' : '' %>> Active employee</label>
</div>
<div class="actions"><button class="button primary">Save employee</button><a class="button" href="employees">Cancel</a></div>
</form></section>
<%_ } _%>
<form class="filter-panel inline-filter"><label>Search employees<input name="q" value="<%= q %>" placeholder="Name, employee ID, department"></label><label>Status<select name="status">
<%_ for (const [k, label] of [['all', 'Current employees'], ['1', 'Active'], ['0', 'Inactive'], ['deleted', 'Deleted']]) { _%>
<option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= label %></option>
<%_ } _%>
</select></label><button class="button primary">Search</button></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Mobile</th><th>Access</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
<%_ if (!list.length) { _%>
<tr><td colspan="6" class="empty">No employees match your search.</td></tr>
<%_ } _%>
<%_ for (const r of list) { const deleted = r.deleted_at !== null; const message = deleted ? 'Restore ' + r.employee_name + ' as an inactive employee?' : 'Delete ' + r.employee_name + '? Login will be disabled. Attendance history will be kept, and you can restore this employee later.'; _%>
<tr><td><div class="person"><span class="avatar"><%= initial(r.employee_name) %></span><div><strong><%= r.employee_name %></strong><small><%= r.employee_code %></small></div></div></td><td><%= r.department %><small class="source"><%= r.designation %></small></td><td><%= r.mobile %></td><td><%= r.password_hash && r.mobile_login ? 'Mobile login ready' : 'Mobile login setup needed' %></td><td><span class="pill <%= Number(r.active) ? 'green' : 'soft' %>"><%= deleted ? 'Deleted' : (Number(r.active) ? 'Active' : 'Inactive') %></span></td><td><div class="actions"><a class="text-link" href="employee-view?id=<%= Number(r.id) %>">View</a><%_ if (!deleted) { _%><a class="text-link" href="?edit=<%= Number(r.id) %>">Edit</a><%_ } _%><form method="post"><%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= Number(r.id) %>"><input type="hidden" name="action" value="<%= deleted ? 'restore' : 'delete' %>"><button type="submit" class="button <%= deleted ? '' : 'danger' %>" data-confirm="<%= message %>"><%= deleted ? 'Restore' : 'Delete' %></button></form></div></td></tr>
<%_ } _%>
</tbody></table></div></section>
<%- include('../partials/page-end') %>
