<%- include('../partials/page-start', { title: 'Scan meal QR', active: 'scan', full: false }) %>
<%- include('../partials/notice') %>
<%- include('../partials/heading', { eyebrow: 'LOGIN → SCAN → EAT', heading: 'Your next meal is one scan away.', description: 'Point your camera at the live QR displayed at the food counter.', actions: '' }) %>
<section class="panel scanner-panel"><div class="scanner-illustration"><%- icon('qr') %></div><h2>Scan meal QR</h2><p>We’ll work out the meal automatically.<br>No dates, times, or meal selection needed.</p><div id="reader"></div><div id="scan-result" role="status" aria-live="polite"></div><div class="actions scanner-actions"><button class="button primary" id="start-scanner"><%- icon('qr') %> Open camera</button><button class="button" id="stop-scanner" hidden>Stop camera</button></div><p class="muted">Allow camera access when prompted. The rear camera is preferred.</p><a class="text-link" href="dashboard">Back to my dashboard</a></section>
<script src="<%= base %>/assets/vendor/html5-qrcode.min.js"></script>
<script defer src="<%= base %>/assets/js/scanner.js"></script>
<%- include('../partials/page-end') %>
